# ─── Base de données ──────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/photopack"

# ─── NextAuth ─────────────────────────────────────────────
# Générer avec: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="REMPLACE_PAR_UNE_CHAINE_ALEATOIRE_DE_32_CHARS"

# ─── Google OAuth ─────────────────────────────────────────
# Créer sur: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Cloudflare R2 ────────────────────────────────────────
# Dashboard Cloudflare → R2 → Manage R2 API tokens
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="photopack-storage"
R2_PUBLIC_DOMAIN=""  # Optionnel: domaine CDN public ex: https://cdn.photopack.fr

# ─── Stripe ───────────────────────────────────────────────
# Dashboard Stripe → Developers → API keys
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Créer dans Stripe → Products (3 produits avec 1 prix each)
STRIPE_PRICE_STARTER=""   # 5€ = 20 crédits
STRIPE_PRICE_PRO=""        # 15€ = 75 crédits
STRIPE_PRICE_STUDIO=""     # 30€ = 200 crédits

# ─── Replicate ────────────────────────────────────────────
# https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=""

# ─── Anthropic (LLM pour SEO + Inpainting) ────────────────
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""

# ─── Resend (emails) ──────────────────────────────────────
# https://resend.com/api-keys
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@photopack.fr"

# ─── App ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
ADMIN_EMAIL="ton-email@gmail.com"
