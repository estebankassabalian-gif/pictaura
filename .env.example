# ─── Base de données ──────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/photopack"

# ─── NextAuth ─────────────────────────────────────────────
# Générer avec: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="REMPLACE_PAR_UNE_CHAINE_ALEATOIRE_DE_32_CHARS"

# ─── Google OAuth (optionnel) ─────────────────────────────
# Créer sur: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Cloudflare R2 ────────────────────────────────────────
# Dashboard Cloudflare → R2 → Manage R2 API tokens
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="photopack-storage"
R2_PUBLIC_DOMAIN=""  # Optionnel: domaine CDN public

# ─── Stripe — 3 tiers + pack one-shot ────────────────────
# Dashboard Stripe → Developers → API keys
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# 3 produits récurrents (Starter 14,90€ / Pro 39,90€ / Business 89,90€)
# chacun avec un prix mensuel et un prix annuel (-20%)
STRIPE_PRICE_STARTER_MONTHLY="price_..."
STRIPE_PRICE_STARTER_ANNUAL="price_..."
STRIPE_PRICE_PRO_MONTHLY="price_..."
STRIPE_PRICE_PRO_ANNUAL="price_..."
STRIPE_PRICE_BUSINESS_MONTHLY="price_..."
STRIPE_PRICE_BUSINESS_ANNUAL="price_..."
# Pack one-shot (paiement unique — 30 crédits à 9,90€)
STRIPE_PRICE_ONESHOT_PACK30="price_..."

# ─── Replicate ────────────────────────────────────────────
# https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=""

# ─── OpenAI (SEO + Score photo) ──────────────────────────
# https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-..."

# ─── Google AI / Gemini (retouche photo IA) ───────────────
# https://aistudio.google.com/app/apikey
GOOGLE_AI_KEY=""

# ─── Resend (emails) ──────────────────────────────────────
# https://resend.com/api-keys
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="noreply@pictaura.com"

# ─── App ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
ADMIN_EMAIL="ton-email@gmail.com"
