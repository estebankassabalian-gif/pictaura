# ─── Base de données ──────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/photopack"

# ─── NextAuth ─────────────────────────────────────────────
# Générer avec: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="REMPLACE_PAR_UNE_CHAINE_ALEATOIRE_DE_32_CHARS"

# ─── Google OAuth (optionnel) ─────────────────────────────
# Créer sur: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Cloudflare R2 ────────────────────────────────────────
# Dashboard Cloudflare → R2 → Manage R2 API tokens
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="photopack-storage"
R2_PUBLIC_DOMAIN=""  # Optionnel: domaine CDN public

# ─── Stripe — 3 tiers + pack one-shot ────────────────────
# Dashboard Stripe → Developers → API keys
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# 3 produits récurrents (Starter 14,90€ / Pro 39,90€ / Business 89,90€)
# chacun avec un prix mensuel et un prix annuel (-20%)
STRIPE_PRICE_STARTER_MONTHLY="price_..."
STRIPE_PRICE_STARTER_ANNUAL="price_..."
STRIPE_PRICE_PRO_MONTHLY="price_..."
STRIPE_PRICE_PRO_ANNUAL="price_..."
STRIPE_PRICE_BUSINESS_MONTHLY="price_..."
STRIPE_PRICE_BUSINESS_ANNUAL="price_..."
# Pack one-shot (paiement unique — 30 crédits à 9,90€)
STRIPE_PRICE_ONESHOT_PACK30="price_..."

# ─── Replicate ────────────────────────────────────────────
# https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=""

# ─── OpenAI (SEO + Score photo) ──────────────────────────
# https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-..."

# ─── Google AI / Gemini (retouche photo IA) ───────────────
# https://aistudio.google.com/app/apikey
GOOGLE_AI_KEY=""

# ─── Couche provider image (P2) ───────────────────────────
# fal.ai : https://fal.ai/dashboard/keys
FAL_KEY=""
IMAGE_PROVIDER_PRIMARY="gemini"   # 'gemini' (défaut) | 'fal'
# Modèle servi par fal — défaut : Nano Banana 2 (= Gemini 3.1 Flash Image,
# LA qualité validée, ~15 s via fal). Alternatif : "fal-ai/flux-pro/kontext"
# (éditeur d'objets — le pipeline active alors le post-enhance Sharp).
IMAGE_FAL_MODEL="fal-ai/nano-banana-2/edit"
# Filet de résilience INTERNE à fal : si IMAGE_FAL_MODEL échoue après tous ses
# retries, une tentative est faite sur ce modèle avant d'abandonner. Nécessaire
# car le secours inter-provider (gemini) est inopérant tant que la facturation
# Google reste cassée. Mettre "" pour désactiver le filet.
IMAGE_FAL_FALLBACK_MODEL="fal-ai/flux-pro/kontext"
IMAGE_PROVIDER_FALLBACK=""        # défaut auto : gemini si primaire=fal
IMAGE_PROVIDER_OVERRIDE=""        # kill-switch : épingle un provider (bypass breaker+failover)
BREAKER_THRESHOLD="4"             # échecs consécutifs avant ouverture du breaker
BREAKER_OPEN_S="120"              # durée d'ouverture → trafic sur le secours

# ─── Resend (emails) ──────────────────────────────────────
# https://resend.com/api-keys
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="noreply@pictaura.com"

# ─── App ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
ADMIN_EMAIL="ton-email@gmail.com"

# ─── Monitoring chemin image (MONITORING_SPEC) ────────────
# Toutes OPTIONNELLES : sans token Telegram, les événements sont enregistrés
# en base mais aucune alerte n'est envoyée. Sans CRON_SECRET, le canary est
# inutilisable. Valeurs = décisions humaines (cf. TACHES_HUMAINES).
TELEGRAM_BOT_TOKEN=""            # BotFather → token du bot d'alertes
TELEGRAM_CHAT_ID=""              # chat/canal qui reçoit les alertes
CRON_SECRET=""                   # openssl rand -hex 24 — protège POST /api/cron/canary
CANARY_ENABLED="false"           # "true" pour activer la sonde synthétique
CANARY_INTERVAL_MIN="45"         # intervalle du cron externe (documentation)
CANARY_MAX_LATENCY_MS="30000"    # au-delà → alerte "modèle lent"
ALERT_ERROR_RATE_THRESHOLD="30"  # % d'échecs sur les 10 derniers appels réels
ALERT_WINDOW_MIN="5"             # fenêtre de comptage des échecs en rafale
ALERT_COOLDOWN_MIN="15"          # anti-spam par type d'alerte
BUDGET_DAILY_CENTS="500"         # seuil budget API image / jour (500 = 5 €)
IMAGE_COST_CENTS="4"             # coût estimé d'un appel image réussi
